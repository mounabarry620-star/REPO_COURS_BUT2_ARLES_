ge="1" parent="p31" source="p3ServiceMonMaster" target="p3Historique"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="p3e5_0" value="«crée»" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fontColor=#000000;spacing=0;" vertex="1" parent="p31"><mxGeometry x="603.0" y="399.0" width="44" height="18" as="geometry"/></mxCell><mxCell id="p3e6" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#000000;fontSize=10;fontFamily=Helvetica;fontColor=#000000;labelBackgroundColor=none;dashed=1;endArrow=open;endSize=10;exitX=1.0;exitY=0.8947;exitDx=0;exitDy=0;entryX=0.1935;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="p31" source="p3ServiceMonMaster" target="p3StatistiqueMaster"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="905" y="332"/></Array></mxGeometry></mxCell><mxCell id="p3e6_0" value="«crée»" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fontColor=#000000;spacing=0;" vertex="1" parent="p31"><mxGeometry x="913.0" y="389" width="44" height="18" as="geometry"/></mxCell><mxCell id="p3e7" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#000000;fontSize=10;fontFamily=Helvetica;fontColor=#000000;labelBackgroundColor=none;endArrow=none;startArrow=diamondThin;startFill=0;startSize=14;exitX=1.0;exitY=0.5556;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5952;entryDx=0;entryDy=0;" edge="1" parent="p31" source="p3Historique" target="p3StatistiqueMaster"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="p3e7_0" value="-statistiques" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fontColor=#000000;spacing=0;" vertex="1" parent="p31"><mxGeometry x="757.0" y="493" width="86" height="18" as="geometry"/></mxCell><mxCell id="p3e7_1" value="3" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fontColor=#000000;spacing=0;" vertex="1" parent="p31"><mxGeometry x="830.0" y="513" width="14" height="18" as="geometry"/></mxCell><mxCell id="p3note0" value="&lt;b&gt;2 requêtes dépendantes&lt;/b&gt; : l'IGN donne la région de la ville (ville.region), qui filtre la requête Mon Master (lieu_reg_acad_lib)." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fontColor=#000000;spacing=0;" vertex="1" parent="p31"><mxGeometry x="20" y="665" width="1120" height="18" as="geometry"/></mxCell><mxCell id="p3note1" value="&lt;b&gt;Héritage&lt;/b&gt; : ServiceMonMaster hérite de ServiceApi : fetch, vérification de response.ok et cache sont réutilisés sans rien réécrire." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fontColor=#000000;spacing=0;" vertex="1" parent="p31"><mxGeometry x="20" y="680" width="1120" height="18" as="geometry"/></mxCell><mxCell id="p3note2" value="&lt;b&gt;Polymorphisme&lt;/b&gt; : Formation et Master ont chacun correspond() ; ServiceParcoursup et ServiceMonMaster ont chacun historique()." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fontColor=#000000;spacing=0;" vertex="1" parent="p31"><mxGeometry x="20" y="695" width="1120" height="18" as="geometry"/></mxCell><mxCell id="p3note3" value="Application les appelle sans connaître le type exact (même idée que Forme, Ellipse et Cercle du chapitre 1)." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fontColor=#000000;spacing=0;" vertex="1" parent="p31"><mxGeometry x="20" y="710" width="1120" height="18" as="geometry"/></mxCell><mxCell id="p3note4" value="&lt;b&gt;Historique&lt;/b&gt; : 2023 est un autre jeu de données avec d'autres noms de champs ; licences 3 de 2023 à 2025, BUT 3 seulement depuis 2024." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fontColor=#000000;spacing=0;" vertex="1" parent="p31"><mxGeometry x="20" y="725" width="1120" height="18" as="geometry"/></mxCell><mxCell id="p3note5" value="Mon Master ne publie pas de coordonnées : pas de carte pour les masters (VueCarte.masquer())." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fontColor=#000000;spacing=0;" vertex="1" parent="p31"><mxGeometry x="20" y="740" width="1120" height="18" as="geometry"/></mxCell><mxCell id="p3note6" value="&lt;b&gt;outils.js&lt;/b&gt; : petites fonctions partagées (sans classe), utilisées par Formation, Master, StatistiqueMaster et les deux services." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fontColor=#000000;spacing=0;" vertex="1" parent="p31"><mxGeometry x="20" y="755" width="1120" height="18" as="geometry"/></mxCell><mxCell id="p3note7" value="&lt;b&gt;Zone « mon département »&lt;/b&gt; : pas de requête en plus ; Application garde, parmi les masters de la région, ceux du département de la ville." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fontColor=#000000;spacing=0;" vertex="1" parent="p31"><mxGeometry x="20" y="770" width="1120" height="18" as="geometry"/></mxCell><mxCell id="p3note8" value="&lt;b&gt;VueTheme&lt;/b&gt; : créée par app.js, indépendante d'Application. L'attribut data-theme de &amp;lt;html&amp;gt; choisit les variables CSS (clair ou sombre)." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fontColor=#000000;spacing=0;" vertex="1" parent="p31"><mxGeometry x="20" y="785" width="1120" height="18" as="geometry"/></mxCell><mxCell id="p3leg" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="p31"><mxGeometry x="845" y="610" width="310" height="91" as="geometry"/></mxCell><mxCell id="p3leg_t" value="&lt;b&gt;Légende : comment lire ce diagramme&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fontColor=#000000;spacing=0;" vertex="1" parent="p31"><mxGeometry x="853" y="616" width="294" height="18" as="geometry"/></mxCell><mxCell id="p3leg_e0" value="" style="html=1;rounded=0;strokeColor=#000000;endArrow=none;startArrow=diamondThin;startFill=0;startSize=14;" edge="1" parent="p31"><mxGeometry relative="1" as="geometry"><mxPoint x="861" y="649.5" as="sourcePoint"/><mxPoint x="921" y="649.5" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3leg_l0" value="garde" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fontColor=#000000;spacing=0;" vertex="1" parent="p31"><mxGeometry x="935" y="640.5" width="212" height="18" as="geometry"/></mxCell><mxCell id="p3leg_e1" value="" style="html=1;rounded=0;strokeColor=#000000;endArrow=block;endFill=0;endSize=10;" edge="1" parent="p31"><mxGeometry relative="1" as="geometry"><mxPoint x="861" y="668.5" as="sourcePoint"/><mxPoint x="921" y="668.5" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3leg_l1" value="hérite de" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fontColor=#000000;spacing=0;" vertex="1" parent="p31"><mxGeometry x="935" y="659.5" width="212" height="18" as="geometry"/></mxCell><mxCell id="p3leg_e2" value="" style="html=1;rounded=0;strokeColor=#000000;dashed=1;endArrow=open;endSize=10;" edge="1" parent="p31"><mxGeometry relative="1" as="geometry"><mxPoint x="861" y="687.5" as="sourcePoint"/><mxPoint x="921" y="687.5" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3leg_l2" value="fabrique" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fontColor=#000000;spacing=0;" vertex="1" parent="p31"><mxGeometry x="935" y="678.5" width="212" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>